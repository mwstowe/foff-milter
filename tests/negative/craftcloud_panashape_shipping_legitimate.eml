  /* Instant-checkout CTA ONLY =E2=80=94 scoped via ic_interactive / ic_sta=
tic so other blocks that share
     the generic otherwise_/outlook_ classes (e.g. ShipmentReview) are unto=
uched.
     New Outlook (Windows + Mac, Monarch) renders the [if !mso] block AND r=
eads compound selectors,
     so the .otherwise_*.outlook_* rules above would reveal the interactive=
 &lt;form> =E2=80=94 which new
     Outlook cannot submit (clicking &quot;Add to cart&quot; does nothing).=
 New Outlook wraps the email body
     in #converted-body (howtotarget.email); that ID outranks the compound =
rules, so force the
     static link there: hide the form, show the link. */
  /* New Outlook&#x27;s body-wrapper id varies by source HTML =E2=80=94 obs=
erved #converted-body (DnD/full-HTML)
     and #body (mailcraft), plus the inner table #innerTable. None exist in=
 Apple Mail/Gmail, so each
     is Outlook-only. Listed separately so Outlook&#x27;s CSS rewriter pref=
ixes every one. */
  #converted-body .ic_interactive {
    display: none !important;
  }
  #body .ic_interactive {
    display: none !important;
  }
  #innerTable .ic_interactive {
    display: none !important;
  }

  #converted-body .ic_static {
    display: block !important;
  }
  #body .ic_static {
    display: block !important;
  }
  #innerTable .ic_static {
    display: block !important;
  }

  /* Outlook.com / OWA web prefixes class names with x_ but NOT attribute s=
electors, so these two
     match ONLY in OWA web (same dead-form problem) =E2=80=94 hide the form=
, show the static link. */
  [class~=3D&#x27;x_ic_interactive&#x27;] {
    display: none !important;
  }

  [class~=3D&#x27;x_ic_static&#x27;] {
    display: block !important;
  }


